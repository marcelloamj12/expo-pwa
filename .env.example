# Copie para .env (local) ou cadastre na Vercel: Settings > Environment Variables.
# Pegue os valores no Firebase Console: Configurações do projeto > Seus apps > App da Web.
# NUNCA coloque aqui chave de service account ou credencial de administrador.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
